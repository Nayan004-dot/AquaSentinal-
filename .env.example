# Copy this file to .env locally. Never commit .env or share real tokens in GitHub.
DATABASE_PATH=data/aquasentinel.sqlite3
DEVICE_TOKENS=AQUASENTINEL-01=replace-with-a-long-random-secret
SAMPLING_INTERVAL_SECONDS=10
DEVICE_STALE_AFTER_SECONDS=120
AGGREGATION_LATE_ARRIVAL_SECONDS=120
AGGREGATION_MIN_VALID_COVERAGE=0.80
AGGREGATION_POLL_SECONDS=60
MAX_HISTORY_DAYS=31
DEFAULT_HISTORY_LIMIT=500
MAX_HISTORY_LIMIT=1000
# Comma-separated exact dashboard origins, e.g. https://dashboard.example.com
CORS_ORIGINS=
